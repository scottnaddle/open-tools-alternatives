---
// 4-2 페이지 변경 이력 아카이빙 (AGENTS.md §2 에이전트 6 + ops/RESEARCH.md §7)
// props: targetPrefix (예: "tools/7-zip", "skills/anatomy", "cases/physicsos-gr3-parabola"),
// limit(기본 5). src/content/changes/*.json 중 target이 prefix로 시작하는 것을 최신순으로 모아 표시.
// 4 navLinks 회귀 우회: 컴포넌트 내부 map 사용(N≤limit). IxCard·skills 카드 등 다른 컴포넌트 map 정상 동작(PR #13).
// Pagefind 인덱스 제외: data-pagefind-filter="exclude" (per-item) + 섹션 hidden.
interface Props {
  targetPrefix: string;   // 예: "tools/7-zip", "skills/anatomy", "cases/<slug>"
  limit?: number;          // 기본 5
}
const { targetPrefix, limit = 5 } = Astro.props;

// 빌드 타임에 모든 changes/*.json을 raw 임포트 — Vite가 빌드 시점에 처리
const all = import.meta.glob('/src/content/changes/*.json', { eager: true, import: 'default' }) as Record<string, any>;

const entries: any[] = [];
for (const [_path, raw] of Object.entries(all)) {
  try {
    const d = typeof raw === 'string' ? JSON.parse(raw) : raw;
    if (!d || typeof d !== 'object') continue;
    const t = d.target;
    if (typeof t !== 'string') continue;
    // 정확히 같은 prefix + . 또는 prefix와 정확히 일치
    if (t === targetPrefix || t.startsWith(targetPrefix + '.')) {
      entries.push(d);
    }
  } catch {}
}

entries.sort((a, b) => String(b.at || '').localeCompare(String(a.at || '')));
const top = entries.slice(0, limit);

// "github.stars" 같은 점-구분 마지막 토큰만 표시
const shortField = (t: string) => {
  if (!t) return '';
  const last = t.split('.').pop() || t;
  return last;
};
const fmtAt = (iso: string) => {
  if (!iso) return '';
  try { return new Date(iso).toISOString().slice(0, 10); } catch { return ''; }
};
const summary = (d: any) => {
  const a = d.after;
  if (a == null) return '(변경 없음)';
  if (typeof a === 'string') return a;
  if (typeof a === 'object' && a !== null) {
    if ('tag' in a) return `→ ${a.tag}${a.date ? ` (${a.date})` : ''}`;
    if ('stars' in a) return `→ ⭐ ${a.stars}`;
    if ('lastPush' in a) return `→ lastPush ${a.lastPush}`;
    if ('value' in a) return `→ ${a.value}`;
    if ('date' in a) return `→ ${a.date}`;
    const keys = Object.keys(a);
    if (keys.length === 1) return `→ ${a[keys[0]]}`;
    if (keys.length <= 3) return `→ ${keys.map((k) => `${k}=${a[k]}`).join(', ')}`;
  }
  return JSON.stringify(a);
};
---
{top.length > 0 && (
  <section class="ix-changelog" aria-label="변경 이력" data-pagefind-filter="exclude">
    <h3>변경 이력 (최근 {top.length}건)</h3>
    <p class="ix-changelog-note">daily-verifier가 매일 GitHub/GitLab API로 재확인한 사실 변경 기록입니다. 1차 출처는 각 항목의 <code>sources</code>를 확인하세요.</p>
    <ol class="ix-changelog-list">
      {top.map((d) => (
        <li class="ix-changelog-item">
          <span class="ix-changelog-date">{fmtAt(d.at)}</span>
          <span class="ix-changelog-field">
            {d.tier === 'C' && <span class="ix-changelog-tier">C</span>}
            {shortField(d.target)}
          </span>
          <span class="ix-changelog-summary">{summary(d)}</span>
          {d.commit && d.commit !== 'pending' && (
            <code class="ix-changelog-commit">commit {String(d.commit).slice(0, 7)}</code>
          )}
        </li>
      ))}
    </ol>
  </section>
)}

<style>
.ix-changelog {
  margin: 28px 0 0;
  padding: 18px 20px;
  background: var(--ground, #F6F5F0);
  border: 1px solid var(--line, #e5e9ef);
  border-radius: 14px;
}
.ix-changelog h3 { font-size: 15px; margin: 0 0 6px; color: var(--ink, #1B2420); font-weight: 700; }
.ix-changelog-note { font-size: 12.5px; color: var(--muted, #5A635E); margin: 0 0 12px; line-height: 1.6; }
.ix-changelog-note code { background: rgba(0, 0, 0, 0.04); padding: 1px 5px; border-radius: 4px; font-size: 11.5px; }
.ix-changelog-list { list-style: none; padding: 0; margin: 0; }
.ix-changelog-item {
  display: grid;
  grid-template-columns: 96px 120px 1fr auto;
  gap: 10px;
  align-items: baseline;
  padding: 8px 0;
  border-top: 1px solid var(--line, #e5e9ef);
  font-size: 13px;
}
.ix-changelog-item:first-child { border-top: 0; }
.ix-changelog-date { color: var(--muted, #5A635E); font-family: ui-monospace, SFMono-Regular, monospace; font-size: 12px; }
.ix-changelog-field { font-weight: 600; }
.ix-changelog-tier {
  display: inline-block;
  font-size: 10.5px;
  padding: 1px 6px;
  border-radius: 4px;
  background: #FFF9EF;
  color: #7A4800;
  border: 1px solid #F2E3C2;
  margin-right: 6px;
  vertical-align: middle;
}
.ix-changelog-summary { color: var(--ink, #1B2420); }
.ix-changelog-commit { font-size: 11.5px; color: var(--muted, #5A635E); font-family: ui-monospace, SFMono-Regular, monospace; }
@media (max-width: 600px) {
  .ix-changelog-item { grid-template-columns: 1fr; gap: 4px; }
  .ix-changelog-date { font-size: 11px; }
}
</style>
