---
// Stage 2: 4축(현장사례/수업지도안/심층리뷰) 공통 카드. 페이지에서는 단일 슬롯이나 직접 렌더해서 map 회귀를 우회한다.
// 회귀: Base.astro에서 navLinks 4개 map 시 Astro 6+TS frontmatter 추론 실패(line 276 매칭 오류 보고).
// 안전을 위해 컴포넌트 내부에 map이 없다. badges는 빈 배열/생략이 기본이며, 호출 측에서 직접 슬롯으로 명시.
interface Props {
  href: string;        // 상세 페이지 링크
  category: string;    // 예: '현장사례' / '수업지도안' / '심층리뷰'
  title: string;       // 카드 제목
  meta?: string;       // 작성자/학교/학년도 등 한 줄 메타
  description: string; // 1~2줄 설명
}
const { href, category, title, meta, description } = Astro.props;
---
<a class="ix-card" href={href}>
  <span class="ix-cat">{category}</span>
  <b class="ix-title">{title}</b>
  <span class="ix-desc">{description}</span>
  {meta && <span class="ix-meta">{meta}</span>}
  <slot name="badges" />
</a>

<style>
.ix-card {
  display: flex; flex-direction: column; gap: 8px;
  padding: 18px 20px; background: var(--surface, #fff);
  border: 1px solid var(--line, #e5e9ef); border-radius: 14px;
  text-decoration: none; color: inherit; transition: border-color .2s, transform .2s;
}
.ix-card:hover { border-color: var(--brand, #1E6A47); transform: translateY(-2px); }
.ix-card:focus-visible { outline: 3px solid #1F4E8C; outline-offset: 2px; }
.ix-cat { font-size: 12px; font-weight: 700; color: var(--brand, #1E6A47); letter-spacing: .04em; }
.ix-title { font-size: 17px; line-height: 1.4; color: var(--ink, #1B2420); }
.ix-desc { font-size: 14px; color: var(--muted, #5A635E); line-height: 1.55; }
.ix-meta { font-size: 12.5px; color: var(--muted, #5A635E); margin-top: auto; }
.ix-card :global(.ix-badge) {
  display: inline-block; font-size: 11px; padding: 2px 8px; border-radius: 999px;
  background: var(--brand-tint, #E4EFE8); color: var(--brand-ink, #134430);
  border: 1px solid #C4DCCD; margin-right: 4px;
}
</style>
