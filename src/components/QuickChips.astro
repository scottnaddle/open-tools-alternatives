---
type Props = Record<"apps" | "base", unknown>;
---
<style>
.u019{position:relative;width:100%}
.u019-head{display:flex;align-items:flex-end;justify-content:center;gap:8px;margin-bottom:10px}
.u019-head b{font-size:var(--fs-sm);font-weight:600;color:var(--ux-muted);white-space:nowrap}
.u019-list{display:flex;flex-wrap:wrap;justify-content:center;align-content:center;gap:8px}
.u019-chip{display:inline-flex;align-items:center;height:38px;padding:0 16px;border:0;border-radius:999px;background:var(--ux-surface);color:var(--ux-ink-2);font-size:var(--fs-body);font-weight:600;text-decoration:none;
  box-shadow:inset 0 0 0 1px var(--ux-line);transition:background-color .08s}
.u019-chip:hover{color:var(--ux-ink);box-shadow:inset 0 0 0 1px var(--ux-ink-3)}
.u019-chip:active{background:var(--ux-surface-3)}
.u019-chip:focus-visible{outline:2px solid var(--ux-accent);outline-offset:3px}
</style>
<div class="ux u019">
  <div class="u019-head">
    <b>많이 찾는 대체</b>
  </div>
  <div class="u019-list">
    {Astro.props.apps.map((a) => (
      <a class="u019-chip" href={`${Astro.props.base}apps/${a.id}/`}>{a.data.name} 대신</a>
    ))}
  </div>
</div>
