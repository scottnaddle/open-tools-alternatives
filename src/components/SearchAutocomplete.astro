<!-- Lucian UX/UI Prompt #034 · MIT License (c) 2026 Seokwoooo · https://lucianlabs.dev/uxui-prompt/#034 -->
---
interface Props {
  index: Array<{
    id: string;
    name: string;
    syn: Array<string>;
    n: number;
  }>;
  base: string;
}

const { index, base } = Astro.props satisfies Props;
---
<style>
.u034{position:relative;width:100%;max-width:680px;margin:0 auto}
.u034-box{position:relative;display:flex;align-items:center;gap:10px;height:56px;padding:0 20px;border-radius:12px;background:var(--ux-surface);box-shadow:0 0 0 1px #B9B7AD;transition:box-shadow .25s var(--ux-ease)}
.u034-box:focus-within{box-shadow:0 0 0 2px var(--ux-accent),0 0 0 6px var(--ux-accent-soft)}
.u034-pl{width:22px;height:22px;flex:none;fill:none;stroke:var(--ux-ink-3);stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;transition:stroke .3s,transform .6s var(--ux-spring)}
.u034.is-set .u034-pl{stroke:var(--ux-accent);transform:translateX(3px) rotate(-12deg)}
.u034-wrap{position:relative;flex:1;height:100%}
.u034-ghost,.u034-in{position:absolute;inset:0;width:100%;padding:0;border:0;font:inherit;font-size:17px;font-weight:650;letter-spacing:-.02em;line-height:56px;background:none;white-space:pre}
.u034-ghost{color:var(--ux-ink-3);pointer-events:none;opacity:.7}
.u034-ghost b{font-weight:inherit;color:transparent}
.u034-in{outline:0;color:var(--ux-ink)}
.u034-in:focus-visible{outline:none}
.u034-btn{flex:none;height:44px;padding:0 20px;border-radius:10px;border:none;background:var(--ux-accent);color:#fff;font-size:16px;font-weight:700;cursor:pointer;transition:transform .2s var(--ux-ease)}
.u034-btn:hover{transform:scale(1.02)}
.u034-btn:active{transform:scale(.96)}
.u034-list{position:absolute;left:0;right:0;top:calc(100% + 10px);z-index:10;margin:0;padding:6px;list-style:none;border-radius:20px;background:var(--ux-surface);box-shadow:0 0 0 1px var(--ux-line),0 26px 50px -30px var(--ux-shadow-strong);max-height:300px;overflow:hidden;transition:opacity .25s var(--ux-ease)}
.u034-list[hidden]{display:none}
.u034-hl{position:absolute;left:6px;right:6px;top:6px;height:64px;border-radius:14px;background:var(--ux-surface-2);transform:translateY(calc(var(--i,0) * 64px));transition:transform .35s var(--ux-spring),opacity .2s;pointer-events:none}
.u034-o{position:relative;display:flex;align-items:center;gap:12px;height:64px;padding:0 12px;border-radius:14px;cursor:pointer;animation:u034-in .35s var(--ux-spring) backwards}
@keyframes u034-in{from{opacity:0;transform:translateY(6px)}}
.u034-o i{width:38px;height:38px;flex:none;border-radius:12px;display:grid;place-items:center;font-style:normal;font-size:11px;font-weight:800;letter-spacing:.04em;color:#fff;background:var(--c)}
.u034-o b{display:block;font-size:15px;font-weight:680}
.u034-o b mark{background:none;color:var(--ux-accent)}
.u034-o small{display:block;margin-top:2px;font-size:12.5px;color:var(--ux-ink-3)}
.u034-o em{margin-left:auto;font-style:normal;font-size:12px;font-weight:650;color:var(--ux-ink-3);font-variant-numeric:tabular-nums}
.u034-none{padding:90px 0;text-align:center;font-size:14px;color:var(--ux-ink-3)}
</style>
<div class="ux u034">
  <form class="u034-box" role="search" data-index={JSON.stringify(Astro.props.index)} data-base={Astro.props.base}>
    <svg class="u034-pl" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
    <div class="u034-wrap">
      <span class="u034-ghost" aria-hidden="true"></span>
      <input class="u034-in" type="search" role="combobox" aria-autocomplete="both" aria-expanded="false" autocomplete="off" placeholder="지금 쓰는 프로그램 이름 (예: CapCut, 알집, 한글, 포토샵, 영상 편집)">
    </div>
    <button class="u034-btn" type="submit">대안 찾기</button>
  </form>
  <ul class="u034-list" role="listbox" aria-label="프로그램 검색 결과" hidden><li class="u034-hl" role="presentation"></li></ul>
</div>
<script is:inline>
(function () {
  const root = document.querySelector('.u034');
  if (!root) return;
  const form = root.querySelector('.u034-box');
  const input = root.querySelector('.u034-in');
  const ghost = root.querySelector('.u034-ghost');
  const list = root.querySelector('.u034-list');
  const hl = root.querySelector('.u034-hl');
  const btn = root.querySelector('.u034-btn');
  const INDEX = JSON.parse(form.dataset.index);
  const BASE = form.dataset.base;
  const uid = 'u034-' + Math.random().toString(36).slice(2, 7);
  input.id = uid + '-in';
  list.id = uid;
  input.setAttribute('aria-controls', uid);

  let shown = [], act = 0;
  
  function esc(s) { return String(s).replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c])); }
  
  function hit(d, q) {
    const lower = q.toLowerCase();
    return d.name.toLowerCase().indexOf(lower) === 0 || d.syn.some(s => s.toLowerCase().indexOf(lower) === 0);
  }
  
  function render() {
    const q = input.value.trim();
    shown = q ? INDEX.filter(d => hit(d, q)).slice(0, 4) : [];
    act = 0;
    Array.prototype.slice.call(list.querySelectorAll('.u034-o,.u034-none')).forEach(n => n.remove());
    hl.style.opacity = shown.length ? '1' : '0';
    
    if (q && !shown.length) {
      list.insertAdjacentHTML('beforeend', '<li class="u034-none">'' + esc(q) + '' 앱을 찾지 못했어요</li>');
    }
    
    shown.forEach((d, i) => {
      const li = document.createElement('li');
      li.className = 'u034-o';
      li.id = uid + '-' + i;
      li.setAttribute('role', 'option');
      li.style.animationDelay = (i * 35) + 'ms';
      let name = esc(d.name);
      if (q && d.name.toLowerCase().indexOf(q.toLowerCase()) === 0) {
        const matchLen = q.length;
        name = '<mark>' + esc(d.name.slice(0, matchLen)) + '</mark>' + esc(d.name.slice(matchLen));
      }
      const cat = ['디자인', '영상', '문서', '유틸리티'][i % 4];
      const colors = ['linear-gradient(140deg,#FF7A93,#F0264D)', 'linear-gradient(140deg,#5B8CFF,#22C3A6)', 'linear-gradient(140deg,#FFB547,#FF7A45)', 'linear-gradient(140deg,#8B6CFF,#3D8BFF)'];
      li.innerHTML = '<i style="--c:' + colors[i % 4] + '" aria-hidden="true">' + d.name.replace(/[^A-Za-z0-9가-힣]/g, '').slice(0, 2) + '</i><span><b>' + name + '</b><small>' + cat + '</small></span><em>' + d.n + '개 대안</em>';
      li.addEventListener('pointermove', () => { if (act !== i) { act = i; mark(); } });
      li.addEventListener('mousedown', e => { e.preventDefault(); choose(i); });
      list.appendChild(li);
    });
    
    list.hidden = shown.length === 0 && !q;
    input.setAttribute('aria-expanded', String(!list.hidden));
    mark();
  }
  
  function mark() {
    hl.style.setProperty('--i', String(act));
    Array.prototype.forEach.call(list.querySelectorAll('.u034-o'), (li, i) => { li.setAttribute('aria-selected', String(i === act)); });
    if (shown[act]) {
      input.setAttribute('aria-activedescendant', uid + '-' + act);
    } else {
      input.removeAttribute('aria-activedescendant');
    }
    const q = input.value.trim(), d = shown[act];
    ghost.innerHTML = d && q && d.name.toLowerCase().indexOf(q.toLowerCase()) === 0 && d.name.toLowerCase() !== q.toLowerCase() ? '<b>' + esc(q) + '</b>' + esc(d.name.slice(q.length)) : '';
  }
  
  function choose(i) {
    const d = shown[i];
    if (!d) return;
    window.location.href = BASE + 'apps/' + d.id + '/';
  }
  
  input.addEventListener('input', () => { root.classList.remove('is-set'); render(); });
  input.addEventListener('keydown', e => {
    if (e.isComposing || e.keyCode === 229) return;
    if (e.key === 'ArrowDown' && shown.length) { e.preventDefault(); act = (act + 1) % shown.length; mark(); }
    else if (e.key === 'ArrowUp' && shown.length) { e.preventDefault(); act = (act - 1 + shown.length) % shown.length; mark(); }
    else if (e.key === 'Enter' && shown.length) { e.preventDefault(); choose(act); }
    else if (e.key === 'Tab' && ghost.textContent && !e.shiftKey && shown.length) { e.preventDefault(); choose(act); }
    else if (e.key === 'Escape') { e.preventDefault(); input.value = ''; root.classList.remove('is-set'); render(); list.hidden = true; input.setAttribute('aria-expanded', 'false'); }
  });
  
  form.addEventListener('submit', e => {
    e.preventDefault();
    if (shown.length > 0) {
      choose(act);
    } else {
      const q = input.value.trim();
      if (q) {
        window.location.href = BASE + 'search/?q=' + encodeURIComponent(q);
      }
    }
  });
  
  document.addEventListener('click', e => {
    if (!root.contains(e.target)) {
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
    }
  });
  
  render();
})();
</script>
