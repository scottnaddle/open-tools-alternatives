<style>
.u070-zone{position:fixed;left:20px;right:20px;bottom:20px;z-index:1000;pointer-events:none;display:flex;justify-content:center}
@media (min-width:600px){.u070-zone{left:auto;width:400px;right:20px}}
.u070-t{position:relative;width:100%;max-width:400px;display:flex;align-items:center;gap:12px;min-height:68px;padding:12px 12px 12px 14px;border-radius:20px;background:var(--ux-surface);box-shadow:0 0 0 1px var(--ux-line),0 16px 30px -18px var(--ux-shadow-strong);transform:translateY(calc(100% + 40px));opacity:0;transition:transform .5s var(--ux-spring),opacity .35s;pointer-events:auto}
.u070-t.show{transform:translateY(0);opacity:1}
.u070-ic{width:36px;height:36px;flex:none;border-radius:12px;display:grid;place-items:center;background:color-mix(in srgb,var(--ux-mint) 15%,transparent);color:var(--ux-mint)}
.u070-ic svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.u070-tx{flex:1;min-width:0}
.u070-tx b{display:block;font-size:14px;font-weight:780;letter-spacing:-.02em}
.u070-tx small{display:block;margin-top:2px;font-size:12.5px;font-weight:600;color:var(--ux-ink-3)}
.u070-x{width:30px;height:30px;flex:none;border:0;padding:0;border-radius:50%;display:grid;place-items:center;background:none;color:var(--ux-ink-3);cursor:pointer}
.u070-x:hover{background:var(--ux-surface-2);color:var(--ux-ink)}
.u070-x svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2.4;stroke-linecap:round}
.u070-x:focus-visible{outline:2px solid var(--ux-accent);outline-offset:1px}
</style>
<div class="ux u070-zone" id="toast-zone">
  <div class="u070-t" id="toast" role="status">
    <span class="u070-ic" aria-hidden="true">
      <svg viewBox="0 0 18 18"><path d="M4 9.4l3.2 3.2L14 5.6"/></svg>
    </span>
    <span class="u070-tx">
      <b>제안 감사합니다</b>
      <small>반영 결과는 변경 이력에서 확인할 수 있어요</small>
    </span>
    <button class="u070-x" type="button" aria-label="알림 닫기">
      <svg viewBox="0 0 14 14"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7"/></svg>
    </button>
  </div>
</div>
<script is:inline>
(function() {
  var toast = document.getElementById('toast');
  var closeBtn = toast.querySelector('.u070-x');
  var hideTimer;
  
  window.showToast = function(title, message) {
    toast.querySelector('b').textContent = title;
    toast.querySelector('small').textContent = message;
    toast.classList.add('show');
    
    clearTimeout(hideTimer);
    hideTimer = setTimeout(function() {
      toast.classList.remove('show');
    }, 4500);
  };
  
  closeBtn.addEventListener('click', function() {
    toast.classList.remove('show');
    clearTimeout(hideTimer);
  });
})();
</script>
