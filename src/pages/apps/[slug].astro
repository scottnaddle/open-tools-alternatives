---
import Base from '../../layouts/Base.astro';
import Status from '../../components/Status.astro';
import ToolFacts from '../../components/ToolFacts.astro';
import Mono from '../../components/Mono.astro';
import { getCollection, getEntry } from 'astro:content';
import { exampleFor, deriveScope, devices, PLAT, SCOPE_NAME, MOE_URL } from '../../lib/facts';
export async function getStaticPaths() {
  return (await getCollection('schoolApps')).map((a) => ({ params: { slug: a.id }, props: { app: a } }));
}
const { app } = Astro.props;
const LV: Record<string, number> = { '거의 대체': 0, '부분 대체': 1 }, DF: Record<string, number> = { '쉬움': 0, '보통': 1, '어려움': 2, '서버 구축': 3 };
const alts = (await Promise.all(app.data.alternatives.map(async (x) => ({ ...x, t: await getEntry(x.tool) }))))
  .sort((a, b) => LV[a.level.value] - LV[b.level.value] || DF[a.installDifficulty] - DF[b.installDifficulty] || b.t.data.github.fetchedAt.localeCompare(a.t.data.github.fetchedAt));
const F = [
  ['기기', [['pc', 'PC실'], ['chromebook', '크롬북·웨일북'], ['tablet', '태블릿']]],
  ['설치', [['noadmin', '관리자 권한 없이 *'], ['web', '설치 없이 웹'], ['offline', '오프라인 *']]],
  ['언어·문서', [['korean', '한국어 화면 *'], ['hwp', 'HWP 열기 *']]],
  ['사용 범위', [['personal', '개인 업무용 *'], ['demo', '수업 시연용 *'], ['offline-install', '설치형 오프라인 *'], ['student-use-check', '학생 직접 사용 *']]],
];
const pairs = alts.length > 1 ? [[alts[0].t.id, alts[1].t.id]] : [];
---
<Base title={`${app.data.name} 대신`}>
  <p class="crumb"><a href="/">대안 찾기</a> › {app.data.category} › {app.data.name}</p>
  <header class="apphead">
    <div>
      <h1>{app.data.name} 대신 쓸 수 있는 오픈소스 <span class="n">{alts.length}개</span></h1>
      {app.data.procurementNote && <p class="lead">{app.data.procurementNote.value}<Status fact={app.data.procurementNote} /></p>}
    </div>
    <a class="btn ghost" href="/suggest/">다른 대안 제안</a>
  </header>
  {app.data.gap && <p class="warn"><b>미리 알아두세요:</b> {app.data.gap.value}<Status fact={app.data.gap} /></p>}

  <div class="filters bar" id="filters">
    {F.map(([label, opts]) => <div class="frow"><span>{label}</span>{opts.map(([k, n]) => <button type="button" class="fchip" data-k={k} aria-pressed="false">{n}</button>)}</div>)}
    <small class="count">* 표시 필터는 <span class="ex">예시 데이터</span> 기준 · 필터 상태는 주소(URL)에 저장돼 공유할 수 있어요.</small>
  </div>
  <p class="count sortrule"><span id="cnt"></span> · 정렬: 대체 정도 → 설치 난이도 → 마지막 확인일 (좋아요·투표 순위 없음)</p>

  <ol class="list">
  {alts.map(({ t, level, installDifficulty, summary }) => {
    const ex = exampleFor(t.id); const p = t.data.platforms.value; const dv = devices(p); const sc = deriveScope(ex);
    const tags = [...Object.entries(dv).filter(([, v]) => v).map(([k]) => k),
      ...(ex.adminRequired !== 'yes' ? ['noadmin'] : []), ...(['offline', 'first-run'].includes(ex.network) ? ['offline'] : []),
      ...(ex.koreanUI === 'yes' ? ['korean'] : []), ...(ex.hwp.read === 'yes' ? ['hwp'] : []), ...sc];
    const lic = t.data.license.value ?? (t.data.pendingLicense ? `확인 중 (제안 ${t.data.pendingLicense.value})` : '확인 필요');
    return <li class="card tool" data-tags={tags.join(' ')}>
      <div class="trow">
        <Mono name={t.data.name} size={52} />
        <div class="tmain">
          <h2>{t.data.name} <span class={`lv lv-${level.value === '거의 대체' ? 'near' : 'part'}`}>{level.value}</span><Status fact={level} /></h2>
          <p class="one">{summary}</p>
          <div class="meta">
            <span class="plats" title="쓸 수 있는 곳 (씨앗 조사값)">{PLAT.map(([k, n, f]) => <i class={f(p) ? 'on' : 'off'}>{n}</i>)}</span><Status fact={t.data.platforms} />
            <span class="lic">라이선스 {lic}</span><Status fact={t.data.license} />
            <span class="df">설치 {installDifficulty}</span>
          </div>
          <div class="chips">{sc.map((s) => <span class={`chip scope-${s}`}>{SCOPE_NAME[s]}</span>)}<span class="st st-ex">예시 데이터</span></div>
          {sc.includes('student-use-check') && <p class="warn">학생이 직접 쓰면 학생 정보가 처리될 수 있어요. <b>학교 절차 확인 필요</b> — <a href={MOE_URL}>교육부 학습지원 소프트웨어 선정 기준 안내</a></p>}
        </div>
      </div>
      <details class="more"><summary>사실 전체 보기 (출처·확인 상태)</summary><ToolFacts t={t} /></details>
    </li>;
  })}
  </ol>
  {pairs.map(([a, b]) => <p><a class="btn ghost" href={`/compare/${a}-vs-${b}/`}>{a} 와 {b} 사실 비교 →</a></p>)}
  <script is:inline>
    const u=new URL(location.href),on=new Set((u.searchParams.get('f')||'').split(',').filter(Boolean));
    function apply(){let n=0;document.querySelectorAll('.fchip').forEach(b=>b.setAttribute('aria-pressed',on.has(b.dataset.k)));
      document.querySelectorAll('.tool').forEach(s=>{const t=s.dataset.tags.split(' ');const ok=[...on].every(k=>t.includes(k));s.hidden=!ok;if(ok)n++;});
      document.getElementById('cnt').textContent=`${n}개 표시`;
      on.size?u.searchParams.set('f',[...on].join(',')):u.searchParams.delete('f');history.replaceState(null,'',u);}
    document.querySelectorAll('.fchip').forEach(b=>b.onclick=()=>{on.has(b.dataset.k)?on.delete(b.dataset.k):on.add(b.dataset.k);apply();});apply();
  </script>
</Base>
