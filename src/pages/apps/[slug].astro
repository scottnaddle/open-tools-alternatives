---
import Base from '../../layouts/Base.astro';
import Status from '../../components/Status.astro';
import Mono from '../../components/Mono.astro';
import Icon from '../../components/Icon.astro';
import ScopeChips from '../../components/ScopeChips.astro';
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { exampleFor, deriveScope, devices, PLAT, SCOPE_NAME, MOE_URL, tone, col, EXAMPLE_LABEL, SYNONYMS } from '../../lib/facts';
import { APP_TOOL_MAP } from '../../lib/search-synonyms';
import scenesData from '../../data/scenes.json';
const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  return (await getCollection('schoolApps')).map((a) => ({ params: { slug: a.id }, props: { app: a } }));
}

interface Props {
  app: CollectionEntry<'schoolApps'>;
}

const { app } = Astro.props;
const synonyms = SYNONYMS[app.id] || [];
const alternativeTools = APP_TOOL_MAP[app.id] || [];
const LV: Record<string, number> = { '거의 대체': 0, '부분 대체': 1 }, DF: Record<string, number> = { '쉬움': 0, '보통': 1, '어려움': 2, '서버 구축': 3 };
const alts = (await Promise.all(app.data.alternatives.map(async (x) => ({ ...x, t: await getEntry(x.tool) }))))
  .sort((a, b) => LV[a.level.value] - LV[b.level.value] || DF[a.installDifficulty] - DF[b.installDifficulty] || b.t.data.github.fetchedAt.localeCompare(a.t.data.github.fetchedAt));

// 장면 카드 — src/data/scenes.json (데이터만 고쳐도 기기별 안내가 바뀌게 분리. 규칙: ops/RESEARCH.md)
const platMatch = (p: any, m: any) =>
  m === 'always' ? false : Object.entries(m).every(([k, v]) =>
    Array.isArray(v) ? (v as string[]).includes(p[k]) : p[k] === v);
const sceneData: { device: string; alts: string[]; hint?: string }[] = scenesData.scenes.map((s: any) => ({
  device: s.label,
  alts: s.match === 'always' ? [] : alts.filter(({ t }) => platMatch(t.data.platforms.value, s.match)).slice(0, s.max ?? 2).map(({ t }) => t.data.name),
  hint: s.hint,
}));
---
<Base title={`${app.data.name} 대신 쓸 수 있는 오픈소스`}>
  <!-- Hidden search metadata for Pagefind -->
  <div data-pagefind-meta="app_synonyms" style="display:none">{synonyms.join(', ')}</div>
  <div data-pagefind-meta="alternative_tools" style="display:none">{alternativeTools.join(', ')}</div>
  <div data-pagefind-meta="app_name" style="display:none">{app.data.name}</div>
  
  <div class="detail" style={tone(app.data.category)}>
    <a class="back" href={base}>홈으로</a>
    <p class="kick">{app.data.category}, {app.data.procurementNote?.value || '현장에서 많이 쓰는 앱'} 
    {app.data.procurementNote && <><Status fact={app.data.procurementNote} /></>}
    </p>
    <div class="dhead">
      <span class="tile" aria-hidden="true"><Icon icon={app.data.icon} /></span>
      <h1>{app.data.name} 대신 쓸 수 있는 오픈소스</h1>
    </div>

    {sceneData && <div class="scene">
      <b>어디서 쓰나요?</b>
      <dl>
        {sceneData.map(({ device, alts, hint }) => (
          <>
            <dt>{device}</dt>
            <dd>
              {alts.length > 0 ? <><b>{alts.join(', ')}</b> <span class="hint">{hint || '설치해서 사용'}</span></> : <span class="hint">아직 마땅한 오픈소스가 없어요</span>}
            </dd>
          </>
        ))}
      </dl>
      <span class="by">각 대안의 기기 지원 정보로 만든 요약입니다. 기기 지원은 확인 중이에요.</span>
    </div>}

    {app.data.gap && <div class="gap">
      <strong>미리 알아두세요.</strong>
      <span>{app.data.gap.value} <Status fact={app.data.gap} /></span>
    </div>}

    <div class="toolbar">
      <span class="hint">대안 {alts.length}개. 점수나 인기로 줄 세우지 않습니다.</span>
      <label class="hint">정렬 <select id="sortSel">
        <option value="lv">대체 정도, 설치 쉬운 순</option>
        <option value="df">설치 쉬운 순</option>
        <option value="act">최근 개발일 순</option>
      </select></label>
    </div>

    <div id="alts">
      {alts.map(({ t, level, installDifficulty, summary }) => {
        const ex = exampleFor(t.id); 
        const p = t.data.platforms.value; 
        const sc = deriveScope(ex);
        const lic = t.data.license.value ?? (t.data.pendingLicense ? `${t.data.pendingLicense.value}` : '확인 필요');
        const lvNum = LV[level.value] || 1;
        const dfNum = DF[installDifficulty] || 0;
        return <article class="alt" data-lv={lvNum} data-df={dfNum} data-act={t.data.github.lastPush}>
          <div class="ahead">
            <div class="amain">
              <span class="amono" aria-hidden="true" style={`background:${col(t.data.name)}`}>
                <Mono name={t.data.name} size={56} />
              </span>
              <div>
                <h2><a href={`${base}tools/${t.id}/`}>{t.data.name}</a></h2>
                <p>{summary}</p>
              </div>
            </div>
            <div class="badges">
              <span class={`badge lv-${level.value === '거의 대체' ? '거의' : '부분'}`}>{level.value}</span>
              <Status fact={level} />
              <span class={`badge df-${installDifficulty.split(' ')[0]}`}>설치 {installDifficulty}</span>
            </div>
          </div>
          <div class="plats">
            <span>쓸 수 있는 곳</span>
            {PLAT.map(([k, n, f]) => <span class={`plat ${f(p) ? 'on' : 'off'}`}>{n}</span>)}
            <Status fact={t.data.platforms} />
            <Status fact={t.data.platforms} />
          </div>
          <div class="meta-row">
            <span class="tagh">개발 {t.data.health}, 최근 개발 {t.data.github.lastPush}</span>
            <span class="tagh">라이선스 {lic} <Status fact={t.data.license} /></span>
          </div>
          <ScopeChips scopes={sc} />
          <div class="actions">
            {(() => {
              const myId = t.id;
              const other = alts.find(({ t: ot }) => ot.id !== myId);
              if (!other) return null;
              const [a, b] = [myId, other.t.id].sort();
              return <a class="btn primary" href={`${base}compare/${a}-vs-${b}/`}>다른 대안과 비교</a>;
            })()}
            <a class="btn" href={`https://github.com/${t.data.github.repo}`}>원 프로젝트 보기</a>
            <a class="btn ghost" href={`${base}suggest/#report`}>정보가 틀렸나요?</a>
          </div>
        </article>;
      })}
    </div>

    <section class="cmp">
      <div class="cmph">
        <h2>기능 비교: {app.data.name === 'CapCut' ? '모둠 발표 영상 만들기' : '주요 기능'}</h2>
        <p class="hint">공식 문서로 확인한 칸부터 채웁니다.</p>
      </div>
      {app.data.featureMatrix ? (
        <div class="tscroll">
          <table>
            <thead>
              <tr>
                <th scope="col">기능</th>
                <th scope="col">{app.data.name}</th>
                {alts.slice(0, 2).map(({ t }) => <th scope="col">{t.data.name}</th>)}
              </tr>
            </thead>
            <tbody>
              {app.data.featureMatrix.map((feat) => (
                <tr>
                  <th scope="row">{feat.name}</th>
                  <td>{feat.sourceUrl ? <a href={feat.sourceUrl}>확인됨</a> : <span class="v null">확인 중</span>}</td>
                  {alts.slice(0, 2).map(() => <td><span class="v null">확인 중</span></td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="hint" style="padding:16px 0">기능 비교는 확인되는 대로 채웁니다.</p>
      )}
    </section>

    <section class="notify">
      <div>
        <h2>설치 없이 학교에서 바로 쓰고 싶으신가요?</h2>
        <p>학교 기기에서 바로 열리는 버전이 생기면 알려 드릴게요.</p>
      </div>
      <form onsubmit="return false">
        <label class="sr" for="em">학교 이메일</label>
        <input id="em" type="email" placeholder="학교 이메일">
        <button class="btn primary">알림 받기</button>
      </form>
    </section>
  </div>

  <script is:inline>
    const s=document.getElementById('sortSel');
    if(s)s.addEventListener('change',()=>{
      const box=document.getElementById('alts');
      const c=[...box.children];
      const k={lv:x=>+x.dataset.lv*10+ +x.dataset.df,df:x=>+x.dataset.df,act:x=>-Date.parse(x.dataset.act)}[s.value];
      c.sort((a,b)=>k(a)-k(b)).forEach(x=>box.appendChild(x))
    });
  </script>
</Base>
