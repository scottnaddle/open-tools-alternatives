---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Changelog from '../../components/Changelog.astro';

// 회피 원칙: 4 navLinks map 회귀 우회. getStaticPaths에서 map 대신 for 루프 + push로 명시.
export async function getStaticPaths() {
  const entries = await getCollection('cases');
  const paths: { params: { slug: string }; props: { entry: any } }[] = [];
  for (const e of entries) {
    paths.push({ params: { slug: e.id }, props: { entry: e } });
  }
  return paths;
}
const { entry } = Astro.props as { entry: CollectionEntry<'cases'> };
const base = import.meta.env.BASE_URL;
---
<Base title={`${entry.data.title} — 현장사례`}>
  <article class="case-detail">
    <a class="back" href={`${base}cases/`}>← 현장사례 목록</a>
    <span class="cat">현장사례 · {entry.data.grade} · {entry.data.unit}</span>
    <h1>{entry.data.title}</h1>
    <p class="meta">(예시) 작성: AI 에이전트 · 학년: {entry.data.grade} · 단원: {entry.data.unit} · 출처: <a href={entry.data.sourceUrl} target="_blank" rel="noopener">{entry.data.sourceUrl}</a></p>

    <div class="callout warn">
      <b>이 사례는 예시입니다.</b> 실제 현장 적용 전에는 학교 환경(컴퓨터실 사양, 관리자 권한, 인터넷 환경)에 맞게 검증이 필요합니다.
    </div>

    <h2>수업 흐름 (예시 · 45분 중 도입 10분)</h2>
    <ol class="steps">
      <li><b>문제 제시 (2분)</b> — 학생들이 종이에 <strong>v²·sin2θ ⁄ g</strong>로 답을 적는다.</li>
      <li><b>예측 공유 (1분)</b> — 모둠별로 답을 공유한다.</li>
      <li><b>스킬 시뮬레이션 (3분)</b> — PhysicsOS 지침에 따라 만들어진 인터랙티브 시뮬레이션을 띄우고, 같은 조건으로 발사 버튼을 눌러 본다.</li>
      <li><b>검증 토론 (3분)</b> — 시뮬 결과와 학생 답을 비교. <strong>공식이 실제 운동을 정확히 기술한다</strong>는 감각을 남긴다.</li>
      <li><b>확장 과제 (1분)</b> — "중력을 달(1.62 m/s²)로 바꾸면?" 같은 다음 차시 예고.</li>
    </ol>

    <h2>이 사례가 도움된 점</h2>
    <ul>
      <li>수식이 실제 운동과 어떻게 연결되는지 <strong>체감</strong>으로 남는다.</li>
      <li>컴퓨터실에서 별도 설치 없이 <strong>브라우저만으로</strong> 동작(외부 라이브러리 0개 단일 HTML).</li>
      <li>단진자 탭으로 가면 작은 각 근사의 한계까지 관찰할 수 있어, 고학년 심화까지 자연스럽게 연결된다.</li>
    </ul>

    <h2>솔직한 한계</h2>
    <ul>
      <li>PhysicsOS는 AI 에이전트가 문장을 이해해 물리 씬을 생성하는 구조라, 교사가 직접 사용하려면 Claude Code 등 에이전트 환경이 필요하다.</li>
      <li>중국어 안내가 기본 — 도입 전에 교사 사전 학습 시간 필요.</li>
      <li>에이전트 환경에서 작업할 때는 <strong>학교 AI 도입 절차</strong>에 따라 안내한다.</li>
    </ul>

    <h2>관련 자료</h2>
    <ul>
      <li><a href={entry.data.sourceUrl} target="_blank" rel="noopener">1차 출처</a></li>
      <li><a href={`${base}skills/122-syf-wcy-PhysicsOS/`}>열린도구 — PhysicsOS 스킬 페이지</a></li>
    </ul>

    <p class="back-to"><a href={`${base}cases/`}>← 현장사례 목록으로</a></p>
    <Changelog targetPrefix={`cases/${entry.id}`} limit={5} />
  </article>
</Base>

<style>
.case-detail { max-width: 760px; margin: 0 auto; padding: 0 4px; }
.case-detail .back { display: inline-block; margin-bottom: 18px; font-size: 13.5px; color: var(--brand, #1E6A47); text-decoration: none; }
.case-detail .back:hover { text-decoration: underline; }
.case-detail .cat { display: inline-block; font-size: 12px; font-weight: 700; color: var(--brand, #1E6A47); background: var(--brand-tint, #E4EFE8); border: 1px solid #C4DCCD; padding: 3px 10px; border-radius: 999px; margin-bottom: 12px; }
.case-detail h1 { font-size: 28px; line-height: 1.3; margin: 0 0 8px; }
.case-detail .meta { font-size: 13px; color: var(--muted, #5A635E); margin: 0 0 24px; line-height: 1.6; }
.case-detail .meta a { color: var(--brand, #1E6A47); }
.case-detail h2 { font-size: 19px; margin: 32px 0 10px; }
.case-detail p, .case-detail ul, .case-detail ol { line-height: 1.7; margin: 0 0 14px; }
.case-detail ul, .case-detail ol { padding-left: 22px; }
.case-detail li { margin-bottom: 6px; }
.case-detail a { color: var(--brand, #1E6A47); }
.case-detail .callout { border: 1px solid #F2E3C2; background: #FFF9EF; border-radius: 12px; padding: 14px 16px; margin: 18px 0; font-size: 14px; }
.case-detail .callout b:first-child { display: inline-block; margin-right: 6px; color: #7A4800; }
.case-detail .steps { counter-reset: cstp; list-style: none; padding: 0; }
.case-detail .steps li { counter-increment: cstp; position: relative; padding-left: 36px; margin-bottom: 12px; }
.case-detail .steps li::before { content: counter(cstp); position: absolute; left: 0; top: 1px; width: 26px; height: 26px; border-radius: 999px; background: var(--brand, #1E6A47); color: #fff; font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.case-detail .back-to { margin-top: 36px; padding-top: 18px; border-top: 1px solid var(--line, #e5e9ef); font-size: 13.5px; }
</style>
