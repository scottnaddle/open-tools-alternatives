---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import IxCard from '../../components/IxCard.astro';

const cases = await getCollection('cases');
cases.sort((a, b) => String(b.data.dateChecked).localeCompare(String(a.data.dateChecked)));
// 단일 예시 1건 — 컬렉션 size 1 가정(게이트와 일치). map은 1회만 실행(4 navLinks 회귀 우회).
const ex = cases[0];
const base = import.meta.env.BASE_URL;
---
<Base title="현장사례 — 학교에서 실제로 쓰인 모습">
  <section class="hero">
    <h1>현장사례</h1>
    <p class="lead">학교에서 실제로 쓰인 오픈소스 대안과 AI 에이전트 스킬의 사례를 모읍니다. 각 사례는 학교·학년·단원 맥락에서 어떻게 쓰였는지, 어떤 점이 도움이 됐는지, 어디에서 아쉬웠는지를 정리합니다.</p>
    <p class="meta">운영 원칙: 사례는 <strong>에이전트가 작성한 예시</strong>이며, 실제 현장 적용 전에는 사용자의 검증이 필요합니다. 출처는 공식 저장소·공식 문서를 기반으로 합니다.</p>
  </section>

  {ex ? (
    <section class="list">
      <IxCard
        href={`${base}cases/${ex.id}/`}
        category={`현장사례 · ${ex.data.grade} · ${ex.data.unit}`}
        title={ex.data.title}
        meta={`(예시) 작성: AI 에이전트 · 학년: ${ex.data.grade} · 단원: ${ex.data.unit} · 출처: ${ex.data.sourceMethod}`}
        description={ex.data.summary}
      >
        {ex.data.badges.map((b) => <span slot="badges" class="ix-badge">{b}</span>)}
      </IxCard>
    </section>
  ) : (
    <section class="list"><p>아직 등록된 사례가 없습니다.</p></section>
  )}

  <section class="note">
    <p>다른 사례를 알고 계시거나 제안하고 싶으시면 <a href={`${base}suggest/`}>대안·정정 제안</a>으로 알려 주세요. 운영 원칙에 따라 출처가 확인된 사례만 추가합니다.</p>
  </section>
</Base>
