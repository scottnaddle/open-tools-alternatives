---
// 모든 도구 비교 페어의 인덱스. P0-2 매트릭스의 한계(학교앱 alternatives 공통에 없는 페어 = 4개 고아)를 해소하기 위해
// compare/[pair] 페이지를 모두 나열한 인덱스 페이지를 제공. 사용자는 여기서 학교앱 매트릭스에 없는 페어도 도달 가능.
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

// compare/[pair]와 동일한 페어 생성(alternatives만 — 학교앱 자신은 tools collection에 없어 compare/[pair] 라우트 생성 불가)
// 4개 고아(apps alternatives 교차 없음)는 인덱스에서도 제외되며, P1(앱 카드 비교 매트릭스 확장)에서 다룬다.
const seen = new Set<string>();
const pairList: { pair: string }[] = [];
for (const a of await getCollection('schoolApps')) {
  const ids = a.data.alternatives.map((x) => x.tool.id);
  const unique = Array.from(new Set(ids)).sort();
  for (let i = 0; i < unique.length; i++) for (let j = i + 1; j < unique.length; j++) {
    const k = `${unique[i]}-vs-${unique[j]}`;
    if (!seen.has(k)) {
      seen.add(k);
      pairList.push({ pair: k });
    }
  }
}
const pairs = pairList.map((p) => p.pair).sort();
const base = import.meta.env.BASE_URL;
---
<Base title="모든 도구 비교" description="학교 앱 대안으로 오른 두 프로그램을 나란히 둔 비교 목록입니다. 점수나 순위는 없습니다." image="compare.png" imageAlt="모든 도구 비교">
  <section class="hero">
    <h1>모든 도구 비교</h1>
    <p class="lead">두 도구를 나란히 놓은 모든 페어를 한 곳에서 찾습니다. 학교앱 페이지의 매트릭스에서 노출되지 않는 페어도 여기서 도달할 수 있어요.</p>
  </section>

  <ul style="list-style:none;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px">
    {pairs.map((p) => (
      <li><a class="btn ghost" href={`${base}compare/${p}/`} style="text-align:center">{p.replace(/-vs-/, ' vs ')}</a></li>
    ))}
  </ul>
</Base>
