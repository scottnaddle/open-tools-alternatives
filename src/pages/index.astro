---
// 디자인 개선안 v2 홈: 검색 하나에 집중, 앱은 표로 훑기(기기별 가능 여부를 열로 비교), 아래 영역은 3개로.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SearchAutocomplete from '../components/SearchAutocomplete.astro';
import { getCollection } from 'astro:content';
import { SYNONYMS } from '../lib/facts';
import { absUrl, websiteLd } from '../lib/seo';
const base = import.meta.env.BASE_URL;
const apps = (await getCollection('schoolApps')).sort((a, b) => a.data.bundle - b.data.bundle);
const tools = new Map((await getCollection('tools')).map((t) => [t.id, t]));
const nAlt = apps.reduce((n, a) => n + a.data.alternatives.length, 0);
const index = apps.map((a) => ({ id: a.id, name: a.data.name, syn: SYNONYMS[a.id] ?? [], n: a.data.alternatives.length }));

const desktop = (p: any) => [p.windows, p.macos, p.linux].includes('yes');
const web = (p: any) => p.web === 'official';
const phone = (p: any) => p.android === 'yes' || p.ios === 'yes' || p.mobileWeb === 'yes';
const phonePart = (p: any) => [p.android, p.ios, p.mobileWeb].includes('partial');
const MARK: Record<string, [string, string]> = { yes: ['●', '가능'], part: ['◐', '일부'], no: ['–', '없음'] };
const DIFF_ORDER = ['쉬움', '보통', '어려움', '서버 구축'];

const rows = apps.map((a) => {
  const ts = a.data.alternatives.map((x) => tools.get(x.tool.id)).filter(Boolean) as any[];
  const ps = ts.map((t) => t.data.platforms.value);
  const pc = ps.some((p) => desktop(p) || web(p)) ? 'yes' : 'no';
  const wb = ps.some(web) ? 'yes' : 'no';
  const ph = ps.some(phone) ? 'yes' : ps.some(phonePart) ? 'part' : 'no';
  const diffs = [...new Set(a.data.alternatives.map((x) => x.installDifficulty))].sort((x, y) => DIFF_ORDER.indexOf(x) - DIFF_ORDER.indexOf(y));
  const near = a.data.alternatives.some((x) => x.level.value === '거의 대체');
  const proc = a.data.procurementNote?.value?.replace('2026년 1~10월 ', '');
  return { a, names: ts.map((t) => t.data.name).join(', '), pc, wb, ph, diff: diffs.join('·'), near, note: proc || '현장에서 많이 쓰는 앱' };
});
const cats = [...new Set(apps.map((a) => a.data.category))];
const recent = [...tools.values()].filter((t) => t.data.github.lastPush && !t.data.github.archived)
  .sort((a, b) => String(b.data.github.lastPush).localeCompare(String(a.data.github.lastPush))).slice(0, 5);
const fetched = recent[0]?.data.github.fetchedAt?.slice(0, 10);
const md = (s: string) => { const [, m, d] = s.split('-'); return `${+m}월 ${+d}일`; };
const quick = [['capcut', 'opencut'], ['alzip', '7-zip'], ['hancom-office', 'hop'], ['photoshop', 'gimp']]
  .map(([aid, tid]) => ({ a: apps.find((x) => x.id === aid), t: tools.get(tid) })).filter((x) => x.a && x.t);
const flagged = [...tools.values()].filter((t) => t.data.github.archived || t.data.health === 'archived');
---
<Base
  title="학교에서 쓰는 앱, 무료 오픈소스로"
  description="학교에서 쓰는 유료 앱 대신 쓸 무료 오픈소스와, 수업·업무에 쓰는 AI 스킬을 한국어로 정리합니다."
  image="home.png"
  imageAlt="학교에서 쓰는 앱, 무료 오픈소스로"
  jsonLd={websiteLd(absUrl(base, '', Astro.site ?? 'https://edtechnewsroom.com'), absUrl(base, 'search/', Astro.site ?? 'https://edtechnewsroom.com'))}
>
  <section class="v2h-hero">
    <div class="v2h-wrap">
      <p class="v2h-eyebrow">학교 앱 {apps.length}개 · 오픈소스 대안 {nAlt}건 · 매일 다시 확인</p>
      <h1>학교에서 쓰는 앱, 무료 오픈소스로 바꿔 쓸 수 있을까요?</h1>
      <SearchAutocomplete index={index} base={base} />
      <p class="v2h-quick">바로 보기:
        {quick.map(({ a, t }, i) => <>{i > 0 && <span aria-hidden="true" class="sep"> · </span>}<a href={`${base}apps/${a!.id}/`}>{a!.data.name} → {t!.data.name}</a></>)}
      </p>
    </div>
  </section>

  <div class="v2h-wrap v2h-main">
    <div class="v2h-bar">
      <div>
        <h2 id="apps">학교 앱별 대안</h2>
        <p class="v2h-count" id="v2h-count" aria-live="polite">{rows.length}개 앱 · 앱 이름을 누르면 기기별 안내와 대안을 볼 수 있어요</p>
      </div>
      <div class="v2h-filters">
        <div class="v2h-seg" role="group" aria-label="분야">
          <button type="button" data-cat="" aria-pressed="true">전체</button>
          {cats.map((c) => <button type="button" data-cat={c} aria-pressed="false">{c}</button>)}
        </div>
        <button type="button" class="v2h-toggle" id="v2h-web" aria-pressed="false">웨일북·크롬북에서 되는 것만</button>
      </div>
    </div>

    <div class="v2h-tblwrap">
      <table class="v2h-tbl">
        <caption class="sr-only">학교에서 쓰는 앱과 오픈소스 대안, 기기별 사용 가능 여부</caption>
        <thead><tr><th scope="col">학교에서 쓰는 앱</th><th scope="col">오픈소스 대안</th><th scope="col">컴퓨터실 PC</th><th scope="col">웨일북·크롬북</th><th scope="col">휴대폰</th><th scope="col">설치</th><th scope="col">대체 정도</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr data-cat={r.a.data.category} data-web={r.wb} data-href={`${base}apps/${r.a.id}/`}>
              <th scope="row"><span class="v2h-app">
                <span class="v2h-ico" aria-hidden="true"><Icon name={r.a.data.icon} /></span>
                <span><a href={`${base}apps/${r.a.id}/`}>{r.a.data.name}</a><small>{r.note}</small></span>
              </span></th>
              <td class="v2h-alt" data-label="대안">{r.names}</td>
              {[['컴퓨터실 PC', r.pc], ['웨일북·크롬북', r.wb], ['휴대폰', r.ph]].map(([l, k]) => (
                <td class={`dv d-${k}`} data-label={l}><span aria-hidden="true">{MARK[k][0]}</span> {MARK[k][1]}</td>
              ))}
              <td data-label="설치">{r.diff}</td>
              <td data-label="대체 정도"><span class={`v2-lv ${r.near ? 'near' : 'part'}`}>{r.near ? '거의 대체' : '부분 대체'}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="v2h-empty" id="v2h-empty" hidden>조건에 맞는 앱이 없어요. <a href={`${base}suggest/`}>대안 요청하기</a></p>
    </div>
    <p class="v2h-foot">구매 학교 수: 공공 조달 기록(school-edtech.kr, 2026년 1~10월, 확인 중). 기기 지원은 각 프로젝트 공개 자료 기준이며 확인 중입니다. e알리미·미리캔버스형 템플릿처럼 아직 좋은 대안이 없는 앱은 <a href={`${base}suggest/`}>대안 요청</a>으로 알려 주세요.</p>

    <div class="v2h-band">
      <section>
        <h2>최근 개발이 활발한 대안</h2>
        <ul class="v2h-list">{recent.map((t) => <li><a href={`${base}tools/${t.id}/`}>{t.data.name}</a><span>{md(t.data.github.lastPush)}</span></li>)}</ul>
        <p class="v2h-small">GitHub 마지막 개발일{fetched && ` · ${fetched} 확인`}</p>
      </section>
      <section>
        <h2>개발 중단·종료 알림</h2>
        {flagged.length ? <ul class="v2h-list">{flagged.map((t) => <li><a href={`${base}tools/${t.id}/`}>{t.data.name}</a><span>개발 중단</span></li>)}</ul>
          : <p>지금 소개 중인 도구에는 알림이 없어요. 공식 발표로 확인되면 대안과 함께 이곳에 올립니다.</p>}
      </section>
      <section id="news">
        <h2>바뀐 정보를 메일로</h2>
        <p>새 대안과 선생님께 영향 있는 업데이트를 주 1회 보내 드릴 예정이에요. 그 전까지는 <a href={`${base}changes/`}>변경 이력</a>과 <a href={`${base}skills/`}>오픈스킬</a>에서 확인할 수 있어요.</p>
        <span class="v2h-soon">준비 중이에요</span>
      </section>
    </div>
  </div>

  <script is:inline>
  (function () {
    var cat = '', webOnly = false;
    var rows = Array.prototype.slice.call(document.querySelectorAll('.v2h-tbl tbody tr'));
    var segs = Array.prototype.slice.call(document.querySelectorAll('.v2h-seg button'));
    var tog = document.getElementById('v2h-web'), cnt = document.getElementById('v2h-count'), empty = document.getElementById('v2h-empty');
    function apply() {
      var n = 0;
      rows.forEach(function (r) {
        var ok = (!cat || r.dataset.cat === cat) && (!webOnly || r.dataset.web === 'yes');
        r.hidden = !ok; if (ok) n++;
      });
      cnt.textContent = n + '개 앱 · 앱 이름을 누르면 기기별 안내와 대안을 볼 수 있어요';
      empty.hidden = n !== 0;
    }
    segs.forEach(function (b) { b.addEventListener('click', function () { cat = b.dataset.cat; segs.forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); }); apply(); }); });
    tog.addEventListener('click', function () { webOnly = !webOnly; tog.setAttribute('aria-pressed', String(webOnly)); apply(); });
    rows.forEach(function (r) { r.addEventListener('click', function (e) { if (e.target.closest('a')) return; location.href = r.dataset.href; }); });
  })();
  </script>
</Base>
