---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('lessons');
  const paths: { params: { slug: string }; props: { entry: any } }[] = [];
  for (const e of entries) {
    paths.push({ params: { slug: e.id }, props: { entry: e } });
  }
  return paths;
}
const { entry } = Astro.props as { entry: CollectionEntry<'lessons'> };
const base = import.meta.env.BASE_URL;
---
<Base title={`${entry.data.title} — 수업지도안`}>
  <article class="lesson-detail">
    <a class="back" href={`${base}lessons/`}>← 수업지도안 목록</a>
    <span class="cat">수업지도안 · {entry.data.grade} · {entry.data.unit}</span>
    <h1>{entry.data.title} (1차시 · {entry.data.duration})</h1>
    <p class="meta">(예시) 작성: AI 에이전트 · 출처: <a href={entry.data.sourceUrl} target="_blank" rel="noopener">{entry.data.sourceUrl}</a></p>

    <div class="callout warn">
      <b>예시 지도안입니다.</b> 학교 환경(컴퓨터실 Windows, 관리자 권한, 학생 기기)에 맞춰 도구 선택·설치 방법을 조정하세요.
    </div>

    <h2>학습 목표</h2>
    <ul>
      <li>파일을 <strong>압축·해제</strong>할 수 있다.</li>
      <li>파일 확장자를 통해 파일 종류를 분류할 수 있다.</li>
      <li>개인 정보가 들어간 파일을 <strong>함부로 공유하지 않는 습관</strong>을 안다.</li>
    </ul>

    <h2>준비물</h2>
    <ul>
      <li>7-Zip 설치 또는 포터블</li>
      <li>예시 폴더(과제 사진·문서 파일 5~6개, 개인정보 포함 파일 1~2개)</li>
      <li>학생용 활동지 1장</li>
    </ul>

    <h2>차시 활동 (40분)</h2>
    <ol class="steps">
      <li><b>도입 (5분)</b> — 친구에게 사진 파일을 보냈을 때 어떻게 되는지 떠올리기. "왜 사진이 그대로 안 가고 압축이 될까?"</li>
      <li><b>도구 살펴보기 (5분)</b> — 7-Zip 설치(또는 포터블 실행), 우클릭 메뉴의 "Add to archive" / "Extract Here" 확인.</li>
      <li><b>실습 1 — 내 폴더 정리 (15분)</b> — 학년·과목별 하위 폴더로 정리, 큰 폴더는 7-Zip으로 압축. <strong>압축 전후 파일 크기 비교</strong>를 활동지에 적기.</li>
      <li><b>실습 2 — 공유할 때 주의 (10분)</b> — 개인정보 포함 파일 분류. <strong>압축만으로 안전해지지 않는다</strong>는 점 강조.</li>
      <li><b>정리 (5분)</b> — 오늘 배운 것 한 줄 정리 + 가정 미션.</li>
    </ol>

    <h2>평가</h2>
    <ul>
      <li>활동지: 압축 전후 크기, 확장자 분류표, "공유해도 되는가" 판단표</li>
      <li>관찰: 마우스 드래그·우클릭 활용, 파일 크기 단위 이해</li>
    </ul>

    <h2>가정·유의사항</h2>
    <ul>
      <li>7-Zip은 무료 오픈소스(LGPL)이지만 학교 라이선스 안내는 <strong>정보부장</strong>와 사전 상의.</li>
      <li>관리자 권한이 없는 환경에서는 <a href="https://www.7-zip.org/download.html" target="_blank" rel="noopener">포터블 버전(.exe)</a>을 USB/개인 폴더에서 실행.</li>
      <li>학생 개인 정보 파일은 <strong>압축 ≠ 암호화</strong>라는 점을 분명히 — 다음 차시에 암호·비밀번호 주제로 연결.</li>
    </ul>

    <h2>관련 자료</h2>
    <ul>
      <li><a href={entry.data.sourceUrl} target="_blank" rel="noopener">1차 출처</a></li>
      <li><a href={`${base}apps/alzip/`}>열린도구 — 알집 대신 7-Zip</a></li>
    </ul>

    <p class="back-to"><a href={`${base}lessons/`}>← 수업지도안 목록으로</a></p>
  </article>
</Base>

<style>
.lesson-detail { max-width: 760px; margin: 0 auto; padding: 0 4px; }
.lesson-detail .back { display: inline-block; margin-bottom: 18px; font-size: 13.5px; color: var(--brand, #1E6A47); text-decoration: none; }
.lesson-detail .back:hover { text-decoration: underline; }
.lesson-detail .cat { display: inline-block; font-size: 12px; font-weight: 700; color: var(--brand, #1E6A47); background: var(--brand-tint, #E4EFE8); border: 1px solid #C4DCCD; padding: 3px 10px; border-radius: 999px; margin-bottom: 12px; }
.lesson-detail h1 { font-size: 26px; line-height: 1.3; margin: 0 0 8px; }
.lesson-detail .meta { font-size: 13px; color: var(--muted, #5A635E); margin: 0 0 24px; line-height: 1.6; }
.lesson-detail .meta a { color: var(--brand, #1E6A47); }
.lesson-detail h2 { font-size: 19px; margin: 32px 0 10px; }
.lesson-detail p, .lesson-detail ul, .lesson-detail ol { line-height: 1.7; margin: 0 0 14px; }
.lesson-detail ul, .lesson-detail ol { padding-left: 22px; }
.lesson-detail li { margin-bottom: 6px; }
.lesson-detail a { color: var(--brand, #1E6A47); }
.lesson-detail .callout { border: 1px solid #F2E3C2; background: #FFF9EF; border-radius: 12px; padding: 14px 16px; margin: 18px 0; font-size: 14px; }
.lesson-detail .callout b:first-child { display: inline-block; margin-right: 6px; color: #7A4800; }
.lesson-detail .steps { counter-reset: lst; list-style: none; padding: 0; }
.lesson-detail .steps li { counter-increment: lst; position: relative; padding-left: 36px; margin-bottom: 12px; }
.lesson-detail .steps li::before { content: counter(lst); position: absolute; left: 0; top: 1px; width: 26px; height: 26px; border-radius: 999px; background: var(--brand, #1E6A47); color: #fff; font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.lesson-detail .back-to { margin-top: 36px; padding-top: 18px; border-top: 1px solid var(--line, #e5e9ef); font-size: 13.5px; }
</style>
