---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import IxCard from '../../components/IxCard.astro';

const lessons = await getCollection('lessons');
lessons.sort((a, b) => String(b.data.dateChecked).localeCompare(String(a.data.dateChecked)));
const ex = lessons[0];
const base = import.meta.env.BASE_URL;
---
<Base title="수업지도안 — 단원·학년별 예시">
  <section class="hero">
    <h1>수업지도안</h1>
    <p class="lead">오픈소스 도구·AI 스킬을 실제 단원에 어떻게 녹일 수 있는지, 학년·단원·차시별 예시 지도안을 모읍니다. 모든 예시는 <strong>에이전트가 작성</strong>했고, 실제 적용 전 검토가 필요합니다.</p>
    <p class="meta">지도안 구성: 단원명 / 대상 / 학습 목표 / 준비물 / 1~2차시 분단위 활동 / 평가 / 가정·유의사항.</p>
  </section>

  {ex ? (
    <section class="list">
      <IxCard
        href={`${base}lessons/${ex.id}/`}
        category={`수업지도안 · ${ex.data.grade} · ${ex.data.unit}`}
        title={ex.data.title}
        meta={`(예시) 작성: AI 에이전트 · 학년: ${ex.data.grade} · 단원: ${ex.data.unit} · 시간: ${ex.data.duration}`}
        description={ex.data.summary}
      >
        {ex.data.badges.map((b) => <span slot="badges" class="ix-badge">{b}</span>)}
      </IxCard>
    </section>
  ) : (
    <section class="list"><p>아직 등록된 지도안이 없습니다.</p></section>
  )}

  <section class="note">
    <p>다른 단원·학년 지도안을 제안하고 싶으시면 <a href={`${base}suggest/`}>대안·정정 제안</a>으로 알려 주세요.</p>
  </section>
</Base>
