---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import IxCard from '../../components/IxCard.astro';

const reviews = await getCollection('reviews');
reviews.sort((a, b) => String(b.data.dateChecked).localeCompare(String(a.data.dateChecked)));
const ex = reviews[0];
const base = import.meta.env.BASE_URL;
---
<Base title="심층리뷰 — 도입 검토용 상세 정리">
  <section class="hero">
    <h1>심층리뷰</h1>
    <p class="lead">도구 도입을 검토하는 교사·정보부장·행정 담당자를 위한 <strong>상세 정리</strong>입니다. 라이선스·플랫폼·설치 난이도·제한·대안을 표로 모아, 학교 도입 결정에 필요한 사실만 모읍니다.</p>
    <p class="meta">모든 리뷰는 공식 저장소·공식 문서를 출처로 하며, <strong>에이전트가 작성</strong>했습니다. 학교 적합성·법적 준수 여부는 판정하지 않습니다.</p>
  </section>

  {ex ? (
    <section class="list">
      <IxCard
        href={`${base}reviews/${ex.id}/`}
        category="심층리뷰 · 도입 검토"
        title={ex.data.title}
        meta={`(예시) 작성: AI 에이전트 · 출처: ${ex.data.sourceMethod} · 검토: 정보부장`}
        description={ex.data.summary}
      >
        {ex.data.badges.map((b) => <span slot="badges" class="ix-badge">{b}</span>)}
      </IxCard>
    </section>
  ) : (
    <section class="list"><p>아직 등록된 리뷰가 없습니다.</p></section>
  )}

  <section class="note">
    <p>도입 검토가 필요한 다른 도구를 제안하고 싶으시면 <a href={`${base}suggest/`}>대안·정정 제안</a>으로 알려 주세요.</p>
  </section>
</Base>
