---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SearchAutocomplete from '../../components/SearchAutocomplete.astro';
import Mono from '../../components/Mono.astro';
import { tone } from '../../lib/facts';

// 스킬 분야를 사이트의 기존 색 묶음에 대응한다. 카드마다 다른 미리보기 칸을 두지 않는다.
const SKILL_TONE: Record<string, string> = {
  '수업자료·발표': '수업 도구',
  '그림·도해': '이미지·디자인',
  '영상·미디어': '영상·오디오',
  '데이터·차트': '문서·오피스',
  '교사 업무·글쓰기': '문서·오피스',
  '웹·앱 만들기': 'AI',
  '기타': '유틸리티',
};

const base = import.meta.env.BASE_URL;
const skills = await getCollection('skills');

// Category counts
const categories = [
  '수업자료·발표',
  '그림·도해',
  '영상·미디어',
  '데이터·차트',
  '교사 업무·글쓰기',
  '웹·앱 만들기',
  '기타'
];

const categoryData = categories.map(cat => ({
  name: cat,
  count: skills.filter(s => s.data.category === cat).length,
  skills: skills.filter(s => s.data.category === cat).sort((a, b) => a.data.name.localeCompare(b.data.name, 'en')),
})).filter(c => c.count > 0);

// Search index for autocomplete
const skillsIndex = skills.map(s => ({
  id: s.data.slug,
  name: s.data.name,
  syn: [],
  n: 1
}));


// '많이 찾는 대체' 블록은 P0-1(보고서 4.6, 4.10)에서 제거됨. 스킬은 '대신'하는 게 아니라 '더하는' 것.

const totalSkills = skills.length;
---
<Base title="오픈스킬 — 수업·업무에 쓰는 AI 스킬" description="선생님이 수업 자료, 그림, 영상, 문서 작업에 쓸 수 있는 오픈소스 AI 스킬을 라이선스와 함께 정리합니다." image="skills.png" imageAlt="오픈스킬">
  <section class="hero-land">
    <div class="wrap herogrid">
      <div>
        <h1>AI 에이전트가 쓸 수 있는 오픈스킬</h1>
        <p class="stat">Claude Code, Codex 등에 설치하는 오픈소스 스킬 <b>{totalSkills}개</b>. 교육 자료 제작, 시각화, 데이터 처리 등 학교 업무에 쓸 수 있는 스킬을 모아 출처와 함께 정리합니다.</p>
        <SearchAutocomplete index={skillsIndex} base={`${base}skills/`} />
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="sh">
      <h2>분야별 스킬</h2>
      <span class="hint">설치만 하면 바로 쓸 수 있는 오픈소스 에이전트 스킬</span>
    </div>

    {categoryData.map(cat => (
      <div style="margin-bottom: 48px;">
        <div class="sh" style="margin-top: 32px; margin-bottom: 16px;">
          <h3 style="font-size: 20px; font-weight: 700;">{cat.name}</h3>
          <span class="hint">{cat.count}개 스킬</span>
        </div>
        <div class="lgrid">
          {cat.skills.map(skill => {
            const { data } = skill;
            return (
              <a class="lcard skill-card" href={`${base}skills/${data.slug}/`} style={tone(SKILL_TONE[data.category] || '유틸리티')}>
                <span class="top">
                  <Mono name={data.name} size={44} />
                  <span class="skill-name">
                    <b>{data.name}</b>
                    <span class="n">{data.usageScope} · {data.license}</span>
                  </span>
                </span>
                <span class="alts">{data.description}</span>
                <span class="skill-foot">⭐ {data.github.stars.toLocaleString('ko-KR')}</span>
              </a>
            );
          })}
        </div>
      </div>
    ))}

    <div class="two">
      <section>
        <div class="sh">
          <h2>스킬 사용 안내</h2>
        </div>
        <div class="list">
          <div class="row">
            <span class="mid">
              <b>설치 방법</b>
              <span>Claude Code나 Codex에서 각 스킬의 GitHub 저장소를 연결하면 바로 사용할 수 있습니다</span>
            </span>
          </div>
          <div class="row">
            <span class="mid">
              <b>수업용 vs 교사 개인용</b>
              <span>교육부 가이드라인 개념을 따라 학생에게 바로 쓸 수 있는지 구분합니다</span>
            </span>
          </div>
        </div>
      </section>

      <section>
        <div class="sh">
          <h2>스킬 제안하기</h2>
        </div>
        <div class="list">
          <div class="row">
            <span class="mid">
              <b>GitHub에서 찾은 스킬이 있나요?</b>
              <span>교육에 쓸 만한 오픈소스 스킬을 알고 계시다면 제안해 주세요</span>
            </span>
          </div>
        </div>
        <a class="btn" href={`${base}suggest/`} style="margin-top: 12px;">스킬 제안하기</a>
      </section>
    </div>
  </div>
</Base>

<style>
.skill-card { min-height: 168px; }
.skill-card .top { align-items: flex-start; }
.skill-card .skill-name { min-width: 0; }
.skill-card .skill-name b,
.skill-card .skill-name .n { display: block; }
.skill-card .skill-name b { overflow-wrap: anywhere; }
.skill-card .alts {
  color: var(--ink-2);
  font-weight: 400;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.skill-card .skill-foot { margin-top: auto; font-size: 12px; color: var(--muted); }
</style>
