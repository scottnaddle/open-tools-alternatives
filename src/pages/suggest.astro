---
import Base from '../layouts/Base.astro';
import FloatingInput from '../components/FloatingInput.astro';
const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/scottnaddle/open-tools-alternatives';
---
<Base title="대안 요청하기" description="대신 쓸 오픈소스를 알려 주시면 GitHub 이슈로 접수합니다. 반영 결과는 변경 이력에서 확인할 수 있어요." image="suggest.png" imageAlt="대안 요청하기">
  <div class="detail wide">
    <a class="back" href={base}>← 홈으로</a>
    <h1 class="ph">대안 요청하기</h1>
    <p class="lead">대신 쓸 오픈소스를 알려 주세요. 아래 내용은 GitHub 이슈로 전달됩니다. 반영 결과는 변경 이력에서 확인할 수 있어요.</p>

    <div class="panel" style="background:var(--server-tint);color:var(--server-ink);margin:20px 0">
      <h2>제안 전에 확인하세요</h2>
      <ul style="margin:0;padding-left:20px">
        <li>제안 내용은 바로 게시되지 않습니다</li>
        <li>에이전트가 공식 출처에서 다시 확인한 뒤 반영합니다</li>
        <li>개인정보(이름, 학교, 연락처)는 적지 마세요</li>
      </ul>
    </div>

    <form class="suggest-form" id="suggest-form">
      <FloatingInput id="app" label="대신하고 싶은 학교 앱" placeholder="예: 미리캔버스, 띵커벨" required={true} />
      <FloatingInput id="tool" label="추천하는 오픈소스 이름 또는 주소" placeholder="예: Excalidraw 또는 https://github.com/excalidraw/excalidraw" required={true} />
      
      <div style="margin-bottom:18px">
        <label for="why" style="display:block;margin-bottom:8px;font-size:var(--fs-body);font-weight:600">수업·업무에서 어떻게 쓰나요? (선택)</label>
        <textarea id="why" rows="4" style="width:100%;padding:12px;border:1.5px solid var(--ux-line-2);border-radius:16px;font:inherit;font-size:var(--fs-body)" placeholder="예: 수업 시간에 칠판 대신 쓰고 싶어요. 학생이 태블릿에서 그림을 그릴 수 있었으면 좋겠어요."></textarea>
      </div>
      
      <div class="warnbox" style="background:var(--warn-tint);color:var(--warn-ink);border-radius:12px;padding:16px;margin-bottom:18px;font-size:var(--fs-body)">
        <strong>개인정보 보호:</strong> 이름·학교명·연락처 등 개인정보는 적지 마세요. 제안 내용은 원 출처 확인 계기로만 사용됩니다.
      </div>

      <button class="btn primary" type="submit">GitHub 이슈로 보내기</button>
      <p class="hint">GitHub 계정이 필요합니다. 이 버튼은 이슈 작성 화면을 엽니다.</p>
    </form>

    <h2 id="report" style="margin-top:48px">정보가 틀렸나요?</h2>
    <p class="lead">사이트에 있는 정보가 틀렸다면 알려 주세요. 이 양식도 GitHub 이슈로 전달됩니다. 반영 결과는 변경 이력에서 확인할 수 있어요.</p>
    
    <form class="report-form" id="report-form">
      <p id="report-target" hidden style="margin:0 0 14px;padding:10px 14px;background:var(--brand-tint);border-radius:10px;font-size:var(--fs-body)"></p>
      <div style="margin-bottom:18px">
        <label for="item" style="display:block;margin-bottom:8px;font-size:var(--fs-body);font-weight:600">어떤 항목이 틀렸나요?</label>
        <select id="item" style="width:100%;height:56px;padding:0 16px;border:1.5px solid var(--ux-line-2);border-radius:16px;font:inherit;font-size:var(--fs-body);background:var(--ux-surface)">
          <option>기기 지원</option>
          <option>대체 정도</option>
          <option>할 수 있어요 / 아직 안 돼요</option>
          <option>설치 난이도·설치 방법</option>
          <option>라이선스</option>
          <option>최근 개발일</option>
          <option>도구 이름</option>
          <option>기타</option>
        </select>
      </div>
      
      <div style="margin-bottom:18px">
        <label for="desc" style="display:block;margin-bottom:8px;font-size:var(--fs-body);font-weight:600">설명 (선택)</label>
        <textarea id="desc" rows="3" style="width:100%;padding:12px;border:1.5px solid var(--ux-line-2);border-radius:16px;font:inherit;font-size:var(--fs-body)" placeholder="어떤 부분이 틀렸는지 간단히 적어 주세요"></textarea>
      </div>
      
      <button class="btn primary" type="submit">GitHub 이슈로 보내기</button>
      <p class="hint">GitHub 계정이 필요합니다. 도구 페이지에서 오면 대상과 항목이 미리 채워집니다.</p>
    </form>
  </div>
  
  <script is:inline define:vars={{ repo }}>
    (function () {
      var q = new URLSearchParams(location.search);
      var tool = q.get('tool') || '';
      var app = q.get('app') || '';
      var field = q.get('field') || '';
      var fieldLabel = {
        platforms: '기기 지원',
        level: '대체 정도',
        can: '할 수 있어요 / 아직 안 돼요',
        cannot: '할 수 있어요 / 아직 안 돼요',
        install: '설치 난이도·설치 방법',
        installDifficulty: '설치 난이도·설치 방법',
        license: '라이선스',
        lastPush: '최근 개발일',
        health: '최근 개발일',
        name: '도구 이름'
      }[field] || '';
      var box = document.getElementById('report-target');
      if ((tool || app || fieldLabel) && box) {
        box.hidden = false;
        box.textContent = '대상: ' + (tool || '(도구 미지정)') + (app ? ' (' + app + ' 대신)' : '') + (fieldLabel ? ' · 항목: ' + fieldLabel : '');
      }
      var item = document.getElementById('item');
      if (item && fieldLabel) {
        Array.prototype.forEach.call(item.options, function (opt) {
          if (opt.textContent === fieldLabel) opt.selected = true;
        });
      }
      var appInput = document.getElementById('app');
      var toolInput = document.getElementById('tool');
      if (appInput && app) appInput.value = app;
      if (toolInput && tool) toolInput.value = tool;
      function issueUrl(template, title, fields) {
        var params = new URLSearchParams();
        params.set('template', template);
        params.set('title', title);
        Object.keys(fields).forEach(function (key) {
          if (fields[key]) params.set(key, fields[key]);
        });
        return repo + '/issues/new?' + params.toString();
      }
      document.getElementById('suggest-form').addEventListener('submit', function (e) {
        e.preventDefault();
        var appName = document.getElementById('app').value.trim();
        var candidate = document.getElementById('tool').value.trim();
        var why = document.getElementById('why').value.trim();
        location.href = issueUrl('app-alternative-request.yml', '[대안 요청] ' + appName, {
          app: appName,
          candidate: candidate,
          usage: why || '수업·업무에서 쓰는 방법을 이슈에 적어 주세요.'
        });
      });
      document.getElementById('report-form').addEventListener('submit', function (e) {
        e.preventDefault();
        var picked = document.getElementById('item').value;
        var desc = document.getElementById('desc').value.trim();
        var page = location.origin + (tool ? ('/alternatives/tools/' + tool + '/') : '/alternatives/');
        var wrong = (tool ? ('도구: ' + tool + '\n') : '') + (app ? ('학교 앱: ' + app + '\n') : '') + '항목: ' + picked + (desc ? ('\n' + desc) : '');
        location.href = issueUrl('fact-correction.yml', '[정보 정정] ' + (tool || picked), {
          page: page,
          wrong: wrong
        });
      });
    })();
  </script>
</Base>
