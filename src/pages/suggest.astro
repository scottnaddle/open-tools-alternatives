---
import Base from '../layouts/Base.astro';
import FloatingInput from '../components/FloatingInput.astro';
import Toast from '../components/Toast.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="대안 요청하기">
  <div class="detail wide">
    <a class="back" href={base}>← 홈으로</a>
    <h1 class="ph">대안 요청하기</h1>
    <p class="lead">대신 쓸 오픈소스를 알려 주세요. 원 출처를 확인한 뒤 반영 여부를 변경 이력에 남겨요.</p>

    <div class="panel" style="background:var(--server-tint);color:var(--server-ink);margin:20px 0">
      <h2>제안 전에 확인하세요</h2>
      <ul style="margin:0;padding-left:20px">
        <li>제안 내용은 바로 게시되지 않습니다</li>
        <li>에이전트가 공식 출처에서 다시 확인한 뒤 반영합니다</li>
        <li>개인정보(이름, 학교, 연락처)는 적지 마세요</li>
      </ul>
    </div>

    <form class="suggest-form" id="suggest-form">
      <FloatingInput id="app" label="대신하고 싶은 학교 앱" placeholder="예: 미리캔버스, 띵커벨" required={true} />
      <FloatingInput id="tool" label="추천하는 오픈소스 이름 또는 주소" placeholder="예: Excalidraw 또는 https://github.com/excalidraw/excalidraw" required={true} />
      
      <div style="margin-bottom:18px">
        <label for="why" style="display:block;margin-bottom:8px;font-size:14px;font-weight:600">수업·업무에서 어떻게 쓰나요? (선택)</label>
        <textarea id="why" rows="4" style="width:100%;padding:12px;border:1.5px solid var(--ux-line-2);border-radius:16px;font:inherit;font-size:16px" placeholder="예: 수업 시간에 칠판 대신 쓰고 싶어요. 학생이 태블릿에서 그림을 그릴 수 있었으면 좋겠어요."></textarea>
      </div>
      
      <div class="warnbox" style="background:var(--warn-tint);color:var(--warn-ink);border-radius:12px;padding:16px;margin-bottom:18px;font-size:14px">
        <strong>개인정보 보호:</strong> 이름·학교명·연락처 등 개인정보는 적지 마세요. 제안 내용은 원 출처 확인 계기로만 사용됩니다.
      </div>

      <button class="btn primary" type="submit">제안 보내기</button>
    </form>

    <h2 id="report" style="margin-top:48px">정보가 틀렸나요?</h2>
    <p class="lead">사이트에 있는 정보가 틀렸다면 알려 주세요. 원 출처를 다시 확인해요.</p>
    
    <form class="report-form" id="report-form">
      <div style="margin-bottom:18px">
        <label for="item" style="display:block;margin-bottom:8px;font-size:14px;font-weight:600">어떤 항목이 틀렸나요?</label>
        <select id="item" style="width:100%;height:56px;padding:0 16px;border:1.5px solid var(--ux-line-2);border-radius:16px;font:inherit;font-size:16px;background:var(--ux-surface)">
          <option>도구 이름</option>
          <option>라이선스</option>
          <option>기기 지원</option>
          <option>최근 개발일</option>
          <option>기타</option>
        </select>
      </div>
      
      <div style="margin-bottom:18px">
        <label for="desc" style="display:block;margin-bottom:8px;font-size:14px;font-weight:600">설명 (선택)</label>
        <textarea id="desc" rows="3" style="width:100%;padding:12px;border:1.5px solid var(--ux-line-2);border-radius:16px;font:inherit;font-size:16px" placeholder="어떤 부분이 틀렸는지 간단히 적어 주세요"></textarea>
      </div>
      
      <button class="btn primary" type="submit">신고하기</button>
    </form>
  </div>
  
  <Toast />
  
  <script is:inline>
    document.getElementById('suggest-form').addEventListener('submit', function(e) {
      e.preventDefault();
      window.showToast('제안 감사합니다', '원 출처를 확인한 뒤 반영 여부를 알려 드릴게요');
      e.target.reset();
      // Trigger lift reset on all fields
      document.querySelectorAll('.u025-f').forEach(function(f) {
        var input = f.querySelector('.u025-in');
        var lab = f.querySelector('.u025-lab');
        f.classList.remove('is-up', 'is-focus');
        f.querySelector('.u025-line').style.setProperty('--gap', '0px');
      });
    });
    
    document.getElementById('report-form').addEventListener('submit', function(e) {
      e.preventDefault();
      window.showToast('확인 요청을 받았어요', '원 출처를 다시 확인한 뒤 반영 여부를 변경 이력에 남깁니다');
      e.target.reset();
    });
  </script>
</Base>
