---
import Base from '../../layouts/Base.astro';
import Status from '../../components/Status.astro';
import Mono from '../../components/Mono.astro';
import Changelog from '../../components/Changelog.astro';
import MediaGuide from '../../components/MediaGuide.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { PLAT, HEALTH } from '../../lib/facts';
import { TOOL_SYNONYMS, CATEGORY_TASKS } from '../../lib/search-synonyms';
import { absUrl, breadcrumbLd, cut, osLabel, softwareLd } from '../../lib/seo';
const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  return (await getCollection('tools')).map((t) => ({ params: { slug: t.id }, props: { tool: t } }));
}

interface Props {
  tool: CollectionEntry<'tools'>;
}

const { tool } = Astro.props;
const t = tool.data;
const lic = t.license.value || (t.pendingLicense ? `${t.pendingLicense.value} (C등급 대기)` : '확인 필요');
const synonyms = TOOL_SYNONYMS[tool.id] || [];
const categoryTasks = CATEGORY_TASKS[t.category] || [];
const site = Astro.site ?? 'https://edtechnewsroom.com';
const pageUrl = absUrl(base, `tools/${tool.id}/`, site);
const appsUsing = (await getCollection('schoolApps')).filter((a) => a.data.alternatives.some((x) => x.tool.id === tool.id));
const sameCategory = (await getCollection('tools'))
  .filter((other) => other.id !== tool.id && other.data.category === t.category)
  .sort((a, b) => a.data.name.localeCompare(b.data.name, 'ko'));
function platState(key: string, value: string, on: boolean) {
  if (on) return 'on';
  if (key !== 'web' && value === 'partial') return 'part';
  return 'off';
}
const seoTitle = `${t.name} – 학교에서 쓸 무료 프로그램`;
const seoDesc = cut(t.schoolUse.value, 150);
---
<Base title={seoTitle} description={seoDesc} image={`tool-${tool.id}.png`} imageAlt={seoTitle} jsonLd={[
  softwareLd({
    name: t.name,
    url: pageUrl,
    description: seoDesc,
    category: t.category,
    operatingSystem: osLabel(t.platforms.value),
    license: t.license.value,
  }),
  breadcrumbLd([{ name: '홈', url: absUrl(base, '', site) }, { name: t.name, url: pageUrl }]),
]}>
  <!-- Hidden search metadata for Pagefind -->
  <div data-pagefind-meta="synonyms" style="display:none">{synonyms.join(', ')}</div>
  <div data-pagefind-meta="category_tasks" style="display:none">{categoryTasks.join(', ')}</div>
  <div data-pagefind-meta="tool_name" style="display:none">{t.name}</div>
  
  <div class="detail">
    <nav class="v2-crumb" aria-label="위치"><a href={base}>홈</a> <span aria-hidden="true">›</span> <span aria-current="page">{t.name}</span></nav>
    <a class="back" href={base}>← 대안 찾기</a>
    <div style="display:flex;align-items:center;gap:18px;margin:16px 0">
      <Mono name={t.name} size={64} />
      <div>
        <h1 style="margin:0">{t.name}</h1>
        <p style="margin:4px 0;color:var(--muted)">{t.schoolUse.value}</p>
      </div>
    </div>

    <div class="panel" style="margin:24px 0">
      <h2>한눈에 보기</h2>
      <table class="ftable">
        <tbody>
          <tr>
            <th>분야</th>
            <td>{t.category}</td>
          </tr>
          <tr>
            <th>설치 난이도</th>
            <td>{t.installDifficulty.value} <Status fact={t.installDifficulty} /></td>
          </tr>
          <tr>
            <th>쓸 수 있는 곳</th>
            <td>
              {PLAT.map(([k, n, f]) => {
                const value = k === 'win' ? t.platforms.value.windows
                  : k === 'mac' ? t.platforms.value.macos
                  : k === 'linux' ? t.platforms.value.linux
                  : k === 'web' ? t.platforms.value.web
                  : k === 'and' ? t.platforms.value.android
                  : t.platforms.value.ios;
                const state = platState(k, value, f(t.platforms.value));
                return <span class={`plat ${state}`} style="margin-right:6px">{n}{state === 'part' ? ' (일부)' : ''}</span>;
              })}
              <Status fact={t.platforms} />
            </td>
          </tr>
          <tr>
            <th>라이선스</th>
            <td>
              {lic} <Status fact={t.license} />
              {t.pendingLicense && <><br/><small class="hint">{t.pendingLicense.note} — 확인 시각 {t.pendingLicense.proposedAt.slice(0, 10)} 이후 24시간 뒤 적용 가능</small></>}
              {!t.pendingLicense && t.licenseNote && <><br/><small class="hint">{t.licenseNote.plainKo || t.licenseNote.note}</small></>}
            </td>
          </tr>
          <tr>
            <th>공식 사이트</th>
            <td>
              {t.officialSite.value ? <a href={t.officialSite.value}>{t.officialSite.value}</a> : '확인 필요'}
              <Status fact={t.officialSite} />
            </td>
          </tr>
          <tr>
            <th>GitHub</th>
            <td>
              <a href={`https://github.com/${t.github.repo}`}>{t.github.repo}</a>
              · 별 {t.github.stars.toLocaleString()}
              · 최근 개발 {t.github.lastPush}
              · {HEALTH[t.health] || t.health}
              {t.github.archived && ' (보관됨)'}
            </td>
          </tr>
          {t.github.latestRelease && (
            <tr>
              <th>{t.github.official?.latestRelease?.fromTag ? '최신 안정 태그' : '최신 릴리스'}</th>
              <td>
                <a href={t.github.latestRelease.url}>{t.github.latestRelease.tag}</a>
                · {t.github.latestRelease.date}
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    {t.features && (
      <div class="panel" style="margin:24px 0">
        <h2>할 수 있는 일</h2>
        <ul style="margin:0;padding-left:20px">
          {t.features.value.map((item) => <li>{item}</li>)}
        </ul>
        <Status fact={t.features} />
      </div>
    )}

    {t.tags.length > 0 && (
      <p class="hint">분류 단어: {t.tags.join(' · ')}</p>
    )}

    <MediaGuide reviews={t.koreanReviews} tutorials={t.tutorials} />

    {t.notes && t.notes.length > 0 && (
      <div class="panel" style="background:var(--warn-tint);color:#4A3000">
        <h2>참고 사항</h2>
        <ul style="margin:0;padding-left:20px">
          {t.notes.map((note) => <li>{note}</li>)}
        </ul>
      </div>
    )}

    {appsUsing.length > 0 && (
      <div class="panel" style="margin:24px 0">
        <h2>이 프로그램을 대안으로 소개하는 앱</h2>
        <ul style="margin:0;padding-left:20px">
          {appsUsing.map((a) => <li><a href={`${base}apps/${a.id}/`}>{a.data.name} 대신 쓸 프로그램</a></li>)}
        </ul>
      </div>
    )}

    {sameCategory.length > 0 && (
      <div class="panel" style="margin:24px 0">
        <h2>같은 분야의 프로그램</h2>
        <ul style="margin:0;padding-left:20px">
          {sameCategory.map((other) => <li><a href={`${base}tools/${other.id}/`}>{other.data.name}</a></li>)}
        </ul>
      </div>
    )}

    <div class="actions" style="margin-top:32px">
      <a class="btn primary" href={`https://github.com/${t.github.repo}`}>GitHub 저장소 →</a>
      {t.officialSite.value && <a class="btn" href={t.officialSite.value}>공식 사이트 →</a>}
      <a class="btn ghost" href={`${base}suggest/?tool=${tool.id}#report`}>정보가 틀렸나요?</a>
    </div>
    <Changelog targetPrefix={`tools/${tool.id}`} limit={5} />
  </div>
</Base>