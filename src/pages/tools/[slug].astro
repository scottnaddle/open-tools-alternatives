---
import Base from '../../layouts/Base.astro';
import Status from '../../components/Status.astro';
import Mono from '../../components/Mono.astro';
import ScopeChips from '../../components/ScopeChips.astro';
import { getCollection } from 'astro:content';
import { PLAT, HEALTH, exampleFor, deriveScope, EXAMPLE_LABEL, MOE_URL } from '../../lib/facts';
export async function getStaticPaths() {
  return (await getCollection('tools')).map((t) => ({ params: { slug: t.id }, props: { tool: t } }));
}
const { tool } = Astro.props;
const t = tool.data;
const ex = exampleFor(tool.id);
const sc = deriveScope(ex);
const lic = t.license.value || (t.pendingLicense ? `${t.pendingLicense.value} (C등급 대기)` : '확인 필요');
---
<Base title={`${t.name} — 오픈소스 도구`}>
  <div class="detail">
    <a class="back" href="/">← 대안 찾기</a>
    <div style="display:flex;align-items:center;gap:18px;margin:16px 0">
      <Mono name={t.name} size={64} />
      <div>
        <h1 style="margin:0">{t.name}</h1>
        <p style="margin:4px 0;color:var(--muted)">{t.schoolUse.value}</p>
      </div>
    </div>

    <div class="panel" style="margin:24px 0">
      <h2>한눈에 보기</h2>
      <table class="ftable">
        <tbody>
          <tr>
            <th>분야</th>
            <td>{t.category}</td>
          </tr>
          <tr>
            <th>설치 난이도</th>
            <td>{t.installDifficulty.value} <Status fact={t.installDifficulty} /></td>
          </tr>
          <tr>
            <th>쓸 수 있는 곳</th>
            <td>
              {PLAT.map(([k, n, f]) => <span class={`plat ${f(t.platforms.value) ? 'on' : 'off'}`} style="margin-right:6px">{n}</span>)}
              <Status fact={t.platforms} />
              {t.platforms.sources && <details class="src"><summary>출처 {t.platforms.sources.length}</summary><ul>{t.platforms.sources.map((s) => <li><a href={s.url}>{s.url}</a><br/><small>{s.method}, {s.fetchedAt.slice(0, 10)}</small></li>)}</ul></details>}
            </td>
          </tr>
          <tr>
            <th>라이선스</th>
            <td>
              {lic} <Status fact={t.license} />
              {t.license.sources && <details class="src"><summary>출처 {t.license.sources.length}</summary><ul>{t.license.sources.map((s) => <li><a href={s.url}>{s.url}</a><br/><small>{s.method}, {s.fetchedAt.slice(0, 10)}</small>{s.excerpt && <><br/><small>{s.excerpt.slice(0, 100)}...</small></>}</li>)}</ul></details>}
              {t.pendingLicense && <><br/><small class="hint">{t.pendingLicense.note} — 확인 시각 {t.pendingLicense.proposedAt.slice(0, 10)} 이후 24시간 뒤 적용 가능</small></>}
            </td>
          </tr>
          <tr>
            <th>공식 사이트</th>
            <td>
              {t.officialSite.value ? <a href={t.officialSite.value}>{t.officialSite.value}</a> : '확인 필요'}
              <Status fact={t.officialSite} />
            </td>
          </tr>
          <tr>
            <th>GitHub</th>
            <td>
              <a href={`https://github.com/${t.github.repo}`}>{t.github.repo}</a>
              · 별 {t.github.stars.toLocaleString()}
              · 최근 개발 {t.github.lastPush}
              · {HEALTH[t.health] || t.health}
              {t.github.archived && ' (보관됨)'}
            </td>
          </tr>
          {t.github.latestRelease && (
            <tr>
              <th>최신 릴리스</th>
              <td>
                <a href={t.github.latestRelease.url}>{t.github.latestRelease.tag}</a>
                · {t.github.latestRelease.date}
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <div class="panel" style="margin:24px 0">
      <h2>쓸 수 있는 범위</h2>
      <ScopeChips scopes={sc} isExample={true} />
      {sc.includes('student-use-check') && (
        <p class="warnbox">
          학생이 직접 쓰면 학생 정보가 처리될 수 있어요. 학교 절차를 확인하세요. 
          <a href={MOE_URL}>교육부 학습지원 소프트웨어 선정 기준 안내</a>
        </p>
      )}
      <p class="hint" style="margin-top:12px">
        쓰임 범위는 공개 규칙으로 계산한 값입니다. 원 사실(학생 정보 처리, 계정 필요, 네트워크)은 <span class="st st-ex">{EXAMPLE_LABEL}</span>
      </p>
    </div>

    {t.notes && t.notes.length > 0 && (
      <div class="panel" style="background:var(--warn-tint);color:#4A3000">
        <h2>참고 사항</h2>
        <ul style="margin:0;padding-left:20px">
          {t.notes.map((note) => <li>{note}</li>)}
        </ul>
      </div>
    )}

    <div class="panel" style="margin:24px 0">
      <h2>변경 이력</h2>
      <p class="hint">이 도구에 대한 최근 5건의 변경 기록입니다. <a href="/changes/">전체 변경 이력 →</a></p>
      <p class="hint"><span class="st st-ex">{EXAMPLE_LABEL}</span> 아직 변경 기록이 없습니다. 검증 에이전트가 실행되면 여기에 표시됩니다.</p>
    </div>

    <div class="actions" style="margin-top:32px">
      <a class="btn primary" href={`https://github.com/${t.github.repo}`}>GitHub 저장소 →</a>
      {t.officialSite.value && <a class="btn" href={t.officialSite.value}>공식 사이트 →</a>}
      <a class="btn ghost" href="/suggest/#report">정보가 틀렸나요?</a>
    </div>
  </div>
</Base>